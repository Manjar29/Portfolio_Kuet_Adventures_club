<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="AdminUser" value="admin" />
    <add key="AdminPass" value="admin123" />
  </appSettings>
  <connectionStrings>
      <add name="DefaultConnection"
        connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=KuetAdventureClubDb;Integrated Security=True;Connect Timeout=30;"
        providerName="System.Data.SqlClient" />
      <add name="KuetDb"
        connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=KuetAdventureClubDb;Integrated Security=True;Connect Timeout=30;"
        providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
</configuration>
